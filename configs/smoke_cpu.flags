# Fast CPU workstation smoke test for Viking in the CARFAC DAL loop.

--max_steps=50
--num_val_examples=8
--global_batch_size=4
--training_example_seconds=0.064
--max_epochs=2
--num_analysis_clips=4

--lambda_l1_waveform=1.0
--lambda_ssim=1.0
--lambda_drift=2.0
--ssim_timewinsz=36
--ssim_chanwinsz=6

--impaired_ohc_health=0.5

--use_low_latency_filterbanks=true
--convert_to_min_phase=true
--shift_factor=64
--num_subbands=256
--prototype_filter_length=256
--num_taps=128
--num_parallel=4
--lstm_depth=2
--lstm_units=16
--hub_units=8
--max_mask_gain=20.0

--checkpoint_step_freq=25
