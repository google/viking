# Published DAL CARFAC configuration adapted for ultra-low-latency Viking (32 kHz).
# Matches arXiv:2606.04103 SSIM + PND SAI objective with 2 ms hop (64 samples @ 32 kHz)
# and minimum-phase FIR synthesis for sub-millisecond algorithmic latency.

--num_analysis_clips=-1

--global_batch_size=32
--training_example_seconds=0.512
--max_epochs=20
--max_steps=5000

--learning_rate=0.0005
--beta1=0.5
--beta2=0.9

--lambda_l1_waveform=0.0
--lambda_ssim=1.0
--lambda_pnd_sai=1.0
--lambda_drift=2.0
--ssim_timewinsz=36
--ssim_chanwinsz=6
--pnd_sai_alpha=0.5
--pnd_sai_beta=0.8

--impaired_ohc_health=0.5

# Viking hearing-aid architecture (32 kHz, 2 ms frame shift, min-phase FIR)
--use_low_latency_filterbanks=true
--convert_to_min_phase=true
--shift_factor=64
--num_subbands=512
--prototype_filter_length=512
--num_taps=256
--num_parallel=4
--lstm_depth=2
--lstm_units=32
--hub_units=8
--in_magnitude_compression=0.3
--max_mask_gain=20.0
--init_mask_gain=2.5

--checkpoint_step_freq=150
--num_val_examples=50
